CREATE DATABASE IF NOT EXISTS bolei_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE bolei_db;

CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    firstname VARCHAR(20) NOT NULL,
    lastname VARCHAR(20) NOT NULL,
    phone VARCHAR(10) NOT NULL,
    email VARCHAR(50) NOT NULL,
    username VARCHAR(20) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role ENUM('visitor', 'manager', 'referee', 'admin') NOT NULL DEFAULT 'visitor',
    status ENUM('pending', 'active') NOT NULL DEFAULT 'pending'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS matchdays (
    matchday_id INT AUTO_INCREMENT PRIMARY KEY,
    matchday_number INT NOT NULL UNIQUE,
    match_date DATE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS standings (
    standing_id INT AUTO_INCREMENT PRIMARY KEY,
    club_name VARCHAR(100) NOT NULL UNIQUE,
    matches_played INT NOT NULL DEFAULT 0,
    points INT NOT NULL DEFAULT 0,
    wins INT NOT NULL DEFAULT 0,
    losses INT NOT NULL DEFAULT 0,
    sets_for INT NOT NULL DEFAULT 0,
    sets_against INT NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS matches (
    id INT AUTO_INCREMENT PRIMARY KEY,
    round INT NOT NULL,
    home_team_id INT NOT NULL,
    away_team_id INT NOT NULL,
    referee_id INT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS result_submissions (
    submission_id INT AUTO_INCREMENT PRIMARY KEY,
    match_id INT NOT NULL,
    referee_id INT NOT NULL,
    match_sheet VARCHAR(255),
    status ENUM('pending', 'valid', 'rejected') NOT NULL DEFAULT 'pending',
    submitted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (referee_id) REFERENCES users(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS match_results (
    match_id INT PRIMARY KEY,
    set1_home INT NOT NULL,
    set1_away INT NOT NULL,
    set2_home INT NOT NULL,
    set2_away INT NOT NULL,
    set3_home INT NOT NULL,
    set3_away INT NOT NULL,
    set4_home INT,
    set4_away INT,
    set5_home INT,
    set5_away INT,
    match_sheet VARCHAR(255) NOT NULL,
    status ENUM('pending', 'valid') NOT NULL DEFAULT 'pending'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS clubs (
    club_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    website VARCHAR(255),
    logo_path VARCHAR(255),
    photo_path VARCHAR(255),
    coach_name VARCHAR(100),
    trainer_name VARCHAR(100),
    physio_name VARCHAR(100),
    manager_name VARCHAR(100),
    stats_name VARCHAR(100),
    video_url VARCHAR(255)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS players (
    player_id INT AUTO_INCREMENT PRIMARY KEY,
    club_id INT NOT NULL,
    jersey_number INT NOT NULL,
    fullname VARCHAR(100) NOT NULL,
    position VARCHAR(50),
    height DECIMAL(3,2),
    birth_date DATE,
    FOREIGN KEY (club_id) REFERENCES clubs(club_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
