CREATE DATABASE IF NOT EXISTS bolei_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
    USE bolei_db;                                                                          
                                                                                           
    CREATE TABLE IF NOT EXISTS users (                                                     
        id INT AUTO_INCREMENT PRIMARY KEY,                                                 
        firstname VARCHAR(20) NOT NULL,                                                    
        lastname VARCHAR(20) NOT NULL,                                                     
        phone VARCHAR(10) NOT NULL,                                                        
        email VARCHAR(50) NOT NULL,                                                       
        username VARCHAR(20) NOT NULL UNIQUE,                                              
        password VARCHAR(255) NOT NULL,                                                    
        role ENUM('visitor', 'manager', 'referee') NOT NULL DEFAULT 'visitor',             
        status ENUM('pending', 'active') NOT NULL DEFAULT 'pending'                        
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;       

    CREATE TABLE clubs (
        club_id INT AUTO_INCREMENT PRIMARY KEY,
        user_id INT UNIQUE,
        team_name VARCHAR(100) NOT NULL,
        website VARCHAR(255) NOT NULL,
        logo VARCHAR(255),
        team_photo VARCHAR(255),
        coach_name VARCHAR(100) NOT NULL,
        trainer_name VARCHAR(100),
        physio_name VARCHAR(100),
        manager_name VARCHAR(100),
        stats_name VARCHAR(100),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (user_id) REFERENCES users(user_id)
            ON DELETE SET NULL
            ON UPDATE CASCADE
    );

    CREATE TABLE players (
        player_id INT AUTO_INCREMENT PRIMARY KEY,
        club_id INT NOT NULL,
        jersey_number INT NOT NULL,
        full_name VARCHAR(100) NOT NULL,
        position ENUM('Outside Hitter', 'Libero', 'Opposite', 'Setter', 'Middle Blocker') NOT NULL,
        height DECIMAL(3,2) NOT NULL,
        birth_date DATE NOT NULL,
        FOREIGN KEY (club_id) REFERENCES clubs(club_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE
    );

    CREATE TABLE matchdays (
        matchday_id INT AUTO_INCREMENT PRIMARY KEY,
        matchday_number INT NOT NULL UNIQUE,
        match_date DATE
    );

    CREATE TABLE matches (
        match_id INT AUTO_INCREMENT PRIMARY KEY,
        matchday_id INT NOT NULL,
        home_club_id INT NOT NULL,
        away_club_id INT NOT NULL,
        home_sets INT DEFAULT NULL,
        away_sets INT DEFAULT NULL,
        result_status ENUM('no_result', 'pending', 'valid') NOT NULL DEFAULT 'no_result',
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (matchday_id) REFERENCES matchdays(matchday_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE,
        FOREIGN KEY (home_club_id) REFERENCES clubs(club_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE,
        FOREIGN KEY (away_club_id) REFERENCES clubs(club_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE
    );

    CREATE TABLE match_sets (
        set_id INT AUTO_INCREMENT PRIMARY KEY,
        match_id INT NOT NULL,
        set_number INT NOT NULL,
        home_points INT NOT NULL,
        away_points INT NOT NULL,
        FOREIGN KEY (match_id) REFERENCES matches(match_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE
    );

    CREATE TABLE result_submissions (
        submission_id INT AUTO_INCREMENT PRIMARY KEY,
        match_id INT NOT NULL,
        referee_id INT NOT NULL,
        match_sheet VARCHAR(255),
        status ENUM('pending', 'valid', 'rejected') NOT NULL DEFAULT 'pending',
        submitted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (match_id) REFERENCES matches(match_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE,
        FOREIGN KEY (referee_id) REFERENCES users(user_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE
    );

    CREATE TABLE standings (
        standing_id INT AUTO_INCREMENT PRIMARY KEY,
        club_id INT NOT NULL UNIQUE,
        matches_played INT NOT NULL DEFAULT 0,
        points INT NOT NULL DEFAULT 0,
        wins INT NOT NULL DEFAULT 0,
        losses INT NOT NULL DEFAULT 0,
        sets_for INT NOT NULL DEFAULT 0,
        sets_against INT NOT NULL DEFAULT 0,
        FOREIGN KEY (club_id) REFERENCES clubs(club_id)
            ON DELETE CASCADE
            ON UPDATE CASCADE
    );

    CREATE TABLE IF NOT EXISTS matches (
        id INT AUTO_INCREMENT PRIMARY KEY,
        round INT NOT NULL,
        home_team_id INT NOT NULL,
        away_team_id INT NOT NULL,
        referee_id INT
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

    CREATE TABLE IF NOT EXISTS match_results (
        match_id INT PRIMARY KEY,
        set1_home INT NOT NULL,
        set1_away INT NOT NULL,
        set2_home INT NOT NULL,
        set2_away INT NOT NULL,
        set3_home INT NOT NULL,
        set3_away INT NOT NULL,
        set4_home INT,
        set4_away INT,
        set5_home INT,
        set5_away INT,
        match_sheet VARCHAR(255) NOT NULL,
        status ENUM('pending', 'valid') NOT NULL DEFAULT 'pending',
        FOREIGN KEY (match_id) REFERENCES matches(id)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
